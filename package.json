{
  "name": "senslop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev",
    "dev:web": "pnpm --filter @senslop/web dev",
    "build": "dotenv -e .env -- turbo run build",
    "typecheck": "dotenv -e .env -- turbo run typecheck && tsc --project tsconfig.tests.json",
    "lint": "turbo run lint",
    "test": "vitest run",
    "db:generate": "pnpm --filter @senslop/database db:generate",
    "db:migrate": "pnpm --filter @senslop/database db:migrate",
    "format": "prettier --write apps packages vitest.config.mts tsconfig*.json turbo.json package.json"
  },
  "devDependencies": {
    "@types/node": "^24",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "prettier": "^3.9.9",
    "tsx": "4.21.0",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
