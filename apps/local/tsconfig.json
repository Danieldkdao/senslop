{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/ui/*": ["../../packages/ui/src/components/ui/*"],
      "@/hooks/use-mobile": ["../../packages/ui/src/hooks/use-mobile.ts"],
      "@/lib/utils": ["../../packages/ui/src/lib/utils.ts"],
      "@/lib/constants": ["../../packages/ui/src/lib/constants.ts"],
      "@/lib/types": ["../../packages/ui/src/lib/types.ts"],
      "@/lib/formatters": ["../../packages/ui/src/lib/formatters.ts"],
      "@/components/providers": [
        "../../packages/ui/src/components/providers.tsx"
      ],
      "@/components/buddy": ["../../packages/ui/src/components/buddy.tsx"],
      "@/components/theme-toggle": [
        "../../packages/ui/src/components/theme-toggle.tsx"
      ],
      "@/components/file-icon": [
        "../../packages/ui/src/components/file-icon.tsx"
      ],
      "@/*": ["./src/*"],
      "@/hooks/use-confirm": ["../../packages/ui/src/hooks/use-confirm.tsx"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
