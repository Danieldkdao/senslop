{
  "name": "@senslop/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/data/env/server.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- tsx src/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8",
    "drizzle-kit": "0.31.11",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "zod": "4.6.5"
  }
}
