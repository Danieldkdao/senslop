{
  "name": "@senslop/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup && node scripts/bundle-local-app.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run --config ../../vitest.config.mts packages/cli",
    "dev": "tsup --watch --onSuccess \"node scripts/bundle-local-app.mjs\"",
    "dev:local": "tsx src/index.ts connect --dev",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@senslop/contracts": "workspace:*",
    "@senslop/local": "workspace:*",
    "@senslop/review-core": "workspace:*",
    "@types/node": "^24",
    "@types/ws": "^8",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "bin": {
    "senslop": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "24.x || >=26"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@napi-rs/keyring": "2.1.0",
    "@t3-oss/env-core": "^0.13.11",
    "diff": "9.0.0",
    "inngest-cli": "1.46.0",
    "open": "^11.0.4",
    "simple-git": "4.0.2",
    "ws": "8.22.0",
    "zod": "4.6.5"
  }
}
