{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/*": ["./apps/web/src/*"]
    },
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "apps/**/tests/**/*.ts",
    "apps/**/tests/**/*.tsx",
    "packages/**/tests/**/*.ts",
    "vitest.config.mts"
  ]
}
